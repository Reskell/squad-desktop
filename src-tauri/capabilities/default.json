{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale : seul le site SQUAD//LOG peut lire les jeux installés et les parties",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://squadlog-three.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-jeux-installes",
    "allow-parties-a-envoyer",
    "allow-parties-envoyees",
    "allow-parties-en-cours"
  ]
}

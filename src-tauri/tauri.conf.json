{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQUAD",
  "version": "0.1.8",
  "identifier": "fr.squad.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SQUAD",
        "url": "https://squadlog-three.vercel.app/play",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2Qjk2MUNFMTE1Q0Y2OTcKUldTWDlsd1J6bUc1SnJaZHBqdkd0N0dpY093MnAxS0NweTN3bDlUS0ZKVlNMMmRMaldEZ1phcWkK",
      "endpoints": [
        "https://github.com/Reskell/squad-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
